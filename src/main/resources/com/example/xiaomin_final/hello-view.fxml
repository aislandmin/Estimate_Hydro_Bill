    </Label>
    <TextField fx:id="tfHydroUnits" promptText="Enter Hydro consumption units" text="12" GridPane.columnIndex="2" GridPane.rowIndex="3">
        <font><Font size="18.0" /></font>
        <GridPane.margin>
            <Insets bottom="12.0" />
        </GridPane.margin>
    </TextField>

    <Label text="Season  : " GridPane.columnIndex="1" GridPane.rowIndex="4">
