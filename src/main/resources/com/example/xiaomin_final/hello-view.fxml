<!--            <Insets bottom="12.0" />-->
<!--        </GridPane.margin>-->
<!--    </TextField>-->
    <RadioButton fx:id="rdbSummer" selected="true" text="Summer" GridPane.columnIndex="2" GridPane.rowIndex="4">
        <font><Font size="18.0" /></font>
    </RadioButton>
    <RadioButton fx:id="rdbWinter" selected="false" text="Winter" GridPane.columnIndex="2" GridPane.rowIndex="5">
